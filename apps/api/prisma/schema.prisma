// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model NseStock {
  id           Int      @id @default(autoincrement())
  symbol       String   @unique
  companyName  String
  sector       String?
  createdAt    DateTime @default(now())
}

model Stock {
  id           Int                  @id @default(autoincrement())
  symbol       String               @unique
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())

  historicalData      HistoricalData[]
  backtestReports     BacktestReport[]
  activeConfigurations ActiveConfiguration[]
  liveSignals         LiveSignal[]
  trades              Trade[]
}

model HistoricalData {
  id        Int      @id @default(autoincrement())
  stockId   Int
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  timeframe String   // "1D", "15m", "5m"

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([stockId, timestamp, timeframe])
  @@index([stockId, timeframe, timestamp])
}

model BacktestReport {
  id           Int      @id @default(autoincrement())
  stockId      Int
  strategyName String
  timeframe    String
  winRate      Float
  totalTrades  Int
  netProfit    Float
  maxDrawdown  Float
  roiPercentage Float
  createdAt    DateTime @default(now())

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId, strategyName])
}

model ActiveConfiguration {
  id           Int    @id @default(autoincrement())
  stockId      Int
  strategyName String
  timeframe    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([stockId, strategyName])
}

model LiveSignal {
  id           Int      @id @default(autoincrement())
  stockId      Int
  strategyName String
  signalType   String   // "BUY" | "SELL"
  entryPrice   Float
  stopLoss     Float
  target       Float
  holdDuration String?  // "INTRADAY" | "SHORT_SWING" | "MID_SWING" | "LONG_POSITIONAL"
  timestamp    DateTime @default(now())
  status       String   @default("ACTIVE") // "ACTIVE" | "CLOSED"

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)
  trade Trade?

  @@index([stockId, status])
}

model Trade {
  id            Int       @id @default(autoincrement())
  signalId      Int       @unique
  stockId       Int
  symbol        String
  strategyName  String
  signalType    String    // "BUY" | "SELL"
  holdDuration  String    // "INTRADAY" | "SHORT_SWING" | "MID_SWING" | "LONG_POSITIONAL"
  entryPrice    Float
  exitPrice     Float?
  stopLoss      Float
  target        Float
  quantity      Int       @default(1)
  capitalUsed   Float     @default(0) // Amount of capital allocated to this trade
  riskAmount    Float     @default(0) // Amount at risk (entry - SL) * quantity
  pnl           Float?
  pnlPercent    Float?
  outcome       String?   // "WIN" | "LOSS" | "BREAKEVEN"
  entryTime     DateTime
  exitTime      DateTime?
  status        String    @default("OPEN") // "OPEN" | "CLOSED"
  notes         String?
  originalStopLoss Float? // Original SL before any trailing adjustments
  trailingState String    @default("INITIAL") // "INITIAL" | "PHASE1" | "PHASE2" | "PHASE3" | "REVERSAL_EXIT"
  peakPrice     Float?    // Best favorable price reached during the trade
  realizedPnl   Float     @default(0) // PnL accumulated from partial exits
  remainingQty  Int       @default(1) // Remaining quantity after partials
  createdAt     DateTime  @default(now())

  signal        LiveSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  stock         Stock      @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId, status])
  @@index([status])
  @@index([strategyName])
}

// Restart-safe idempotency for scheduled Telegram digests. One row = one digest
// already sent for a given period + IST bucket key; the unique constraint is the
// atomic "already sent" lock (survives container restarts, unlike in-memory guards).
model SentDigest {
  id        Int      @id @default(autoincrement())
  period    String   // "DAILY" | "WEEKLY" | "OVERALL"
  periodKey String   // IST bucket: DAILY=YYYY-MM-DD, WEEKLY=Monday date, OVERALL=Friday date
  sentAt    DateTime @default(now())

  @@unique([period, periodKey])
}

// Durable mirror of DhanService.openPositions (in-memory Map). Survives an api restart so
// a position entered before a redeploy is not orphaned: on boot the service reloads OPEN
// rows and reconciles them against Dhan's actual positions/orders. Deliberately decoupled
// from Trade (real qty/fills differ from the sim) — no FK to LiveSignal; signalId is the key.
model DhanPosition {
  id            Int      @id @default(autoincrement())
  signalId      Int      @unique // = LiveSignal.id (no FK; decoupled from the sim record)
  symbol        String
  side          String   // "BUY" | "SELL" (entry side)
  qty           Int
  simEntryPrice Float
  orderId       String?  // Dhan entry order id
  fillPrice     Float?   // real entry fill price
  stopPrice     Float?   // original stop the resting SL is pegged to
  slOrderId     String?  // resting STOP_LOSS (limit) order id
  status        String   @default("OPEN") // "OPEN" | "CLOSED"
  exitOrderId   String?
  exitFillPrice Float?
  realizedPnl   Float?
  closeReason   String?  // "market" | "SL fired" | "reconciled-flat-on-boot" | ...
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

// Durable per-day Dhan guardrail state. One row per IST day (self-expiring). Lets the
// daily-loss kill-switch survive a restart — otherwise a redeploy re-enables live trading
// and zeroes the day's loss even after the switch tripped.
model DhanDailyState {
  id                Int      @id @default(autoincrement())
  dayKey            String   @unique // IST date string — matches DhanService.dayKey
  realizedLossToday Float    @default(0)
  ordersToday       Int      @default(0)
  killed            Boolean  @default(false) // daily-loss kill-switch tripped today
  updatedAt         DateTime @updatedAt
}
