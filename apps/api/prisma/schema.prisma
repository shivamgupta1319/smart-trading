// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // No `url` here on purpose: the connection is supplied at runtime by the
  // @prisma/adapter-pg driver adapter (see PrismaService). Adding a url breaks
  // `prisma generate` at image-build time (no DATABASE_URL in the build env).
}

model NseStock {
  id           Int      @id @default(autoincrement())
  symbol       String   @unique
  companyName  String
  sector       String?
  createdAt    DateTime @default(now())
}

model Stock {
  id           Int                  @id @default(autoincrement())
  symbol       String               @unique
  isActive     Boolean              @default(true)
  sector       String?              // GICS-style sector tag (backfilled from yfinance) for risk concentration
  // Set by the engine when stored daily history has a large move nobody has reviewed
  // (config/known_price_actions.json). NULL = nothing to review.
  dataFlag       String?
  dataFlagDetail String?
  // Dhan's NSE_EQ security id for this stock (from Dhan's scrip master). Needed before any
  // cell on this stock can be switched on for real money.
  dhanSecurityId String?
  // On the intraday list: 5- and 15-minute candles are fetched and intraday strategies are
  // tested and may trade here. Every active stock is on the swing list (daily candles).
  // Chosen by measurement: see apps/engine/universe.py.
  intraday       Boolean  @default(false)
  // Measured from the last 60 daily candles by apps/engine/universe.py.
  tradedValueCr  Float? // median value traded per day, in crore rupees
  dayRangePct    Float? // median (high - low) / close of a day, in percent
  lastClose      Float?
  createdAt    DateTime             @default(now())

  historicalData      HistoricalData[]
  backtestReports     BacktestReport[]
  activeConfigurations ActiveConfiguration[]
  liveSignals         LiveSignal[]
  trades              Trade[]
}

model HistoricalData {
  id        Int      @id @default(autoincrement())
  stockId   Int
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float
  timeframe String   // "1D", "15m", "5m"

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([stockId, timestamp, timeframe])
  @@index([stockId, timeframe, timestamp])
}

model BacktestReport {
  id           Int      @id @default(autoincrement())
  stockId      Int
  strategyName String
  timeframe    String
  winRate      Float
  totalTrades  Int
  netProfit    Float
  maxDrawdown  Float
  roiPercentage Float
  // Edge metrics (audit 2026-07-15 F3). The engine always computed these; they were
  // dropped on write, leaving roiPercentage — raw-cumulative and window-dependent —
  // as the only column anything could rank on. avgRMultiple is the honest one: net
  // P&L per rupee risked, independent of compounding, horizon and position size.
  // Nullable because pre-existing rows genuinely don't know them (0 would assert
  // "zero edge"); they fill in on the next backtest run.
  avgRMultiple   Float?
  profitFactor   Float?
  maxDrawdownPct Float?
  expectancy     Float?
  // Calendar years the cell's bars actually span, measured from the data rather than
  // assumed per timeframe — so ROI can be annualised honestly (1D ≈ 5.1y vs 15m/5m
  // ≈ 4.7mo made raw ROI ~13× incomparable across buckets).
  spanYears      Float?
  // Average R of the first and of the second half of the trades. The live rule
  // (apps/engine/selection_rule.py) needs both to be positive.
  rFirstHalf     Float?
  rSecondHalf    Float?
  // Engine model version that produced these numbers. Bumped when the fill/exit
  // model changes (e.g. C3), so stored reports that won't reproduce are identifiable.
  engineVersion String  @default("unversioned")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  // Exactly one report row per cell; every writer UPSERTs on this key.
  @@unique([stockId, strategyName, timeframe])
  @@index([stockId, strategyName])
}

model ActiveConfiguration {
  id           Int    @id @default(autoincrement())
  stockId      Int
  strategyName String
  timeframe    String
  // Lifecycle, set by the API from this cell's own closed trades (common/lifecycle.ts):
  // "TESTING" (default) | "PROVEN" | "PAUSED". A PAUSED cell keeps paper-trading, but
  // its trades are stamped PAUSED and kept out of the main book.
  status          String    @default("TESTING")
  statusReason    String?
  statusChangedAt DateTime?
  // Second lock for real money: set by the owner. Real orders also need status = PROVEN.
  liveEnabled     Boolean   @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@unique([stockId, strategyName])
  @@index([status])
}

model LiveSignal {
  id           Int      @id @default(autoincrement())
  stockId      Int
  strategyName String
  signalType   String   // "BUY" | "SELL"
  entryPrice   Decimal  @db.Decimal(18, 4)
  stopLoss     Decimal  @db.Decimal(18, 4)
  target       Decimal  @db.Decimal(18, 4)
  holdDuration String?  // "INTRADAY" | "SHORT_SWING" | "MID_SWING" | "LONG_POSITIONAL"
  timestamp    DateTime @default(now())
  status       String   @default("ACTIVE") // "ACTIVE" | "CLOSED"

  stock Stock @relation(fields: [stockId], references: [id], onDelete: Cascade)
  trade Trade?

  @@index([stockId, status])
  // NOTE: a PARTIAL unique index `(stockId, strategyName) WHERE status='ACTIVE'`
  // is also enforced at the DB level (see migrations) to prevent duplicate
  // active signals. Prisma can't express partial uniques, so it lives in SQL.
}

model Trade {
  id            Int       @id @default(autoincrement())
  signalId      Int       @unique
  stockId       Int
  symbol        String
  strategyName  String
  signalType    String    // "BUY" | "SELL"
  holdDuration  String    // "INTRADAY" | "SHORT_SWING" | "MID_SWING" | "LONG_POSITIONAL"
  entryPrice    Decimal   @db.Decimal(18, 4)
  exitPrice     Decimal?  @db.Decimal(18, 4)
  stopLoss      Decimal   @db.Decimal(18, 4)
  target        Decimal   @db.Decimal(18, 4)
  quantity      Int       @default(1)
  capitalUsed   Decimal   @default(0) @db.Decimal(18, 4) // Capital allocated to this trade
  riskAmount    Decimal   @default(0) @db.Decimal(18, 4) // Amount at risk (entry - SL) * quantity
  pnl           Decimal?  @db.Decimal(18, 4)
  pnlPercent    Float?    // a ratio, not money — kept as Float
  outcome       String?   // "WIN" | "LOSS" | "BREAKEVEN"
  entryTime     DateTime
  exitTime      DateTime?
  status        String    @default("OPEN") // "OPEN" | "CLOSED"
  notes         String?
  originalStopLoss Decimal? @db.Decimal(18, 4) // Original SL before any trailing adjustments
  trailingState String    @default("INITIAL") // "INITIAL" | "PHASE1" | "PHASE2" | "PHASE3" | "REVERSAL_EXIT"
  peakPrice     Decimal?  @db.Decimal(18, 4)   // Best favorable price reached during the trade
  realizedPnl   Decimal   @default(0) @db.Decimal(18, 4) // PnL accumulated from partial exits
  remainingQty  Int       @default(1) // Remaining quantity after partials
  // The cell's lifecycle status when this trade was opened. "PAUSED" = test book.
  cellStatusAtEntry String?
  // The market's condition when the trade was opened (labels; nothing is blocked on them).
  regimeAtEntry          String?   // NIFTY daily: TRENDING_UP | TRENDING_DOWN | RANGING | VOLATILE
  marketDirectionAtEntry String?   // the day so far across the roster: UP | DOWN | FLAT
  breadthAtEntry         Float?    // % of roster stocks above their day open
  alignedWithMarket      Boolean?  // BUY in UP / SELL in DOWN = true; the reverse = false; FLAT = null
  createdAt     DateTime  @default(now())

  signal        LiveSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  stock         Stock      @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@index([stockId, status])
  @@index([status])
  @@index([strategyName])
}

// One row per Telegram digest already sent, so a restart never sends a second copy.
model SentDigest {
  id        Int      @id @default(autoincrement())
  period    String   // "DAILY" | "WEEKLY" | "OVERALL"
  periodKey String   // IST date: the day (DAILY, OVERALL) or that week's Monday (WEEKLY)
  sentAt    DateTime @default(now())

  @@unique([period, periodKey])
}

// One stored luck check (apps/engine/luck_check.py): every strategy on every active stock,
// with the corrected chance that its result is luck. Written by the engine.
model LuckCheckRun {
  id            Int      @id @default(autoincrement())
  computedAt    DateTime @default(now())
  engineVersion String
  stocks        Int
  trials        Int // tries on record when this run was judged
  rows          Json // one object per strategy
}

// A real position at the Dhan broker, kept in the database so a restart never orphans it:
// on boot the service reloads OPEN rows and reconciles them against Dhan's own records.
// Deliberately separate from Trade (real quantity and fills differ from the paper trade);
// signalId is the link, with no foreign key.
model DhanPosition {
  id            Int      @id @default(autoincrement())
  signalId      Int      @unique // = LiveSignal.id
  symbol        String
  securityId    String?  // broker id used for the entry; exits use this, not the roster
  side          String   // "BUY" | "SELL" (entry side)
  qty           Int
  simEntryPrice Float
  orderId       String?  // Dhan entry order id (null = logged only, nothing at the broker)
  fillPrice     Float?   // real entry fill price
  stopPrice     Float?   // original stop the resting broker stop is pegged to
  slOrderId     String?  // resting STOP_LOSS (limit) order id
  status        String   @default("OPEN") // "OPEN" | "CLOSED"
  exitOrderId   String?
  exitFillPrice Float?
  realizedPnl   Float?
  closeReason   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

// Per-day real-money counters. One row per IST day, so the daily-loss kill switch
// survives a restart.
model DhanDailyState {
  id                Int      @id @default(autoincrement())
  dayKey            String   @unique // IST date string
  realizedLossToday Float    @default(0)
  ordersToday       Int      @default(0)
  killed            Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

// The current Dhan access token (valid about 24 hours), kept so a restart reuses it instead
// of asking Dhan for a new one. One row, id = 1. It is a credential: treat database dumps
// accordingly.
model DhanToken {
  id        Int      @id @default(1)
  token     String
  expiresAt DateTime
  updatedAt DateTime @updatedAt
}
