# smart-trading (v1) — copy to .env on the host. Gitignored. NEVER commit real values.
# Telegram alerts (api). The previously-committed token was revoked — put the NEW one here.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Engine LLM keys (used by engine + scanner for analysis).
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""
# CORS origins the API accepts (browser origin). Public subdomain is included by default.
# CORS_ORIGINS="http://localhost:5173,https://trading.pseo.cloud"

# ── Dhan real-money execution adapter (api). See docs/dhan-live-execution.md ──
# Mode gate: off (pure sim) | log (log intended orders, no API) | sandbox | live.
DHAN_TRADING_MODE="off"
# Credentials — from web.dhan.co → Profile → DhanHQ Trading APIs (Access Token mode + TOTP).
DHAN_CLIENT_ID=""
DHAN_PIN=""
DHAN_TOTP_SECRET=""
DHAN_ACCESS_TOKEN=""
# Optional overrides (sane defaults in compose): notional cap, qty cap, daily order cap, kill-switch loss.
# DHAN_API_BASE="https://api.dhan.co/v2"
# DHAN_MAX_NOTIONAL="12500"
# DHAN_MAX_QTY="20"
# DHAN_MAX_ORDERS_PER_DAY="20"
# DHAN_MAX_DAILY_LOSS="1000"
